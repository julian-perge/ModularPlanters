root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# These match google-java-format, so the IDE formatter and the pre-commit hook agree.
[*.java]
indent_style = space
indent_size = 2
max_line_length = 100

[*.json]
insert_final_newline = false
